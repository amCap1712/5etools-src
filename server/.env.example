# Copy to .env and adjust. All variables are optional for local development.

# Secret used to sign JWTs. REQUIRED in production.
TAVERN_SECRET_KEY=change-me

# Postgres connection string. Falls back to a local SQLite file if unset.
DATABASE_URL=postgresql+psycopg2://tavern:tavern@localhost:5432/tavern

# Google OAuth 2.0 Web client ID (from https://console.cloud.google.com/apis/credentials).
# Leave unset to disable Google Sign-In (username/password still works).
GOOGLE_CLIENT_ID=

# Comma-separated list of allowed CORS origins, or * (default).
TAVERN_CORS_ORIGINS=*

# Days before a login token expires (default 30).
TAVERN_JWT_EXPIRY_DAYS=30

# Directory for uploaded avatars/portraits (default: server/uploads).
# TAVERN_UPLOAD_DIR=
